[Unit]
Description=Cardano Node
After=network.target

[Service]
User=cardano
Group=cardano
Type=simple
Environment=CARDANO_NODE_SOCKET_PATH=/var/lib/cardano/node/node.socket
ExecStart=/usr/local/bin/cardano-node run --topology /etc/cardano/topology.json --database-path /var/lib/cardano/node --socket-path /var/lib/cardano/node/node.socket --host-addr 0.0.0.0 --port 3001 --config /etc/cardano/config.json
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
